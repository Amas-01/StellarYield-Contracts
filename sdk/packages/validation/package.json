{
  "name": "@stellaryield/validation",
  "version": "0.1.0",
  "description": "Zod schemas for validating StellarYield backend API responses client-side (Issue #867)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run --exclude **/drift.types.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express-serve-static-core": "^4.17.21",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "stellar",
    "soroban",
    "stellaryield",
    "zod",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/StellarYield/StellarYield-Contracts.git",
    "directory": "sdk/packages/validation"
  },
  "publishConfig": {
    "access": "public"
  }
}
